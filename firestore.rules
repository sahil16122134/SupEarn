rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================================
       USERS
       Document ID = Firebase UID
       ============================================================ */

    match /users/{firebaseUid} {

      // User can read their own document.
      // Admin can read user documents.
      allow read: if request.auth != null
        && (
          request.auth.uid == firebaseUid
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
          )
        );

      // New normal user.
      allow create: if request.auth != null
        && request.auth.uid == firebaseUid
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.role == "user"
        && request.resource.data.coinBalance == 0
        && request.resource.data.totalEarnedCoins == 0
        && request.resource.data.totalRedeemedCoins == 0;

      // Owner can update their own document.
      // Admin can update user documents.
      allow update: if request.auth != null
        && (
          (
            request.auth.uid == firebaseUid
            && resource.data.firebaseUid == request.auth.uid
            && request.resource.data.firebaseUid == resource.data.firebaseUid
            && request.resource.data.role == resource.data.role
            && request.resource.data.telegramId == resource.data.telegramId
          )
          ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
          )
        );

      allow delete: if false;
    }


    /* ============================================================
       SETTINGS
       ============================================================ */

    match /settings/{docId} {

      allow read: if true;

      allow write: if request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }


    /* ============================================================
       TASKS
       Admin creates/updates/deletes.
       Signed-in users can read active tasks.
       ============================================================ */

    match /tasks/{taskId} {

      allow read: if request.auth != null;

      allow create, update, delete: if request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }


    /* ============================================================
       TASK COMPLETIONS
       One completion per Firebase UID + task.
       ============================================================ */

    match /taskCompletions/{completionId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.reward is int
        && request.resource.data.reward > 0
        && request.resource.data.taskId is string
        && request.resource.data.provider is string;

      allow update, delete: if false;
    }


    /* ============================================================
       REDEEM REQUESTS
       ============================================================ */

    match /redeemRequests/{requestId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.amount is int
        && request.resource.data.amount > 0;

      allow update: if false;

      allow delete: if request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }


    /* ============================================================
       REFERRALS
       Document ID remains Telegram ID.
       ============================================================ */

    match /referrals/{telegramId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.telegramId == telegramId
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.tasksCompleted == 0
        && request.resource.data.bonusPaid == false;

      allow update: if request.auth != null
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid == resource.data.firebaseUid
        && request.resource.data.telegramId == resource.data.telegramId
        && request.resource.data.referrerId == resource.data.referrerId;

      allow delete: if false;
    }
  }
}
