rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================================
       HELPER FUNCTIONS
       ============================================================ */

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }


    /* ============================================================
       USERS
       Document ID = Firebase UID
       ============================================================ */

    match /users/{firebaseUid} {

      // User can read their own document.
      // Admin can read all users.
      allow read: if signedIn()
        && (
          request.auth.uid == firebaseUid
          || isAdmin()
        );


      // Normal user creation.
      allow create: if signedIn()
        && request.auth.uid == firebaseUid
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.role == "user"
        && request.resource.data.coinBalance == 0
        && request.resource.data.totalEarnedCoins == 0
        && request.resource.data.totalRedeemedCoins == 0;


      // User can update their own allowed user data.
      // Admin can update any user.
      allow update: if signedIn()
        && (
          (
            request.auth.uid == firebaseUid
            && resource.data.firebaseUid == request.auth.uid
            && request.resource.data.firebaseUid == resource.data.firebaseUid
            && request.resource.data.role == resource.data.role
            && request.resource.data.telegramId == resource.data.telegramId
          )
          || isAdmin()
        );


      allow delete: if false;
    }


    /* ============================================================
       SETTINGS
       ============================================================ */

    match /settings/{docId} {

      // App settings can be read by anyone.
      allow read: if true;

      // Only admins can change settings.
      allow create, update, delete: if isAdmin();
    }


    /* ============================================================
       TASKS
       ============================================================ */

    match /tasks/{taskId} {

      // Signed-in users can read tasks.
      // The client additionally queries active == true
      // and hidden == false.
      allow read: if signedIn();

      // Only admins can create, update or delete tasks.
      allow create, update, delete: if isAdmin();
    }


    /* ============================================================
       TASK COMPLETIONS
       ============================================================ */

    match /taskCompletions/{completionId} {

      // Signed-in users can read completion records.
      allow read: if signedIn();

      // User can create a completion only for themselves.
      allow create: if signedIn()
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.reward is int
        && request.resource.data.reward > 0
        && request.resource.data.taskId is string
        && request.resource.data.provider is string;

      // Completion records cannot be modified or deleted
      // by the client.
      allow update, delete: if false;
    }


    /* ============================================================
       REDEEM REQUESTS
       ============================================================ */

    match /redeemRequests/{requestId} {

      allow read: if signedIn();

      // User can create only their own pending redeem request.
      allow create: if signedIn()
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.amount is int
        && request.resource.data.amount > 0;

      // Client cannot modify requests after creation.
      allow update: if false;

      // Admin can delete requests.
      allow delete: if isAdmin();
    }


    /* ============================================================
       REFERRALS
       Document ID = Telegram ID
       ============================================================ */

    match /referrals/{telegramId} {

      allow read: if signedIn();

      // User can create their own referral record.
      allow create: if signedIn()
        && request.resource.data.telegramId == telegramId
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.tasksCompleted == 0
        && request.resource.data.bonusPaid == false;

      // User can update only their own referral record.
      // Telegram ID, Firebase UID and referrer cannot be changed.
      allow update: if signedIn()
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid == resource.data.firebaseUid
        && request.resource.data.telegramId == resource.data.telegramId
        && request.resource.data.referrerId == resource.data.referrerId;

      allow delete: if false;
    }
  }
}    /* ============================================================
       REDEEM REQUESTS
       ============================================================ */

    match /redeemRequests/{requestId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.amount is int
        && request.resource.data.amount > 0;

      allow update: if false;

      allow delete: if request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }


    /* ============================================================
       REFERRALS
       Document ID remains Telegram ID.
       ============================================================ */

    match /referrals/{telegramId} {

      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.telegramId == telegramId
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.tasksCompleted == 0
        && request.resource.data.bonusPaid == false;

      allow update: if request.auth != null
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid == resource.data.firebaseUid
        && request.resource.data.telegramId == resource.data.telegramId
        && request.resource.data.referrerId == resource.data.referrerId;

      allow delete: if false;
    }
  }
}
