rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }


    // ============================================================
    // USERS
    // Document ID = Firebase UID
    // ============================================================

    match /users/{firebaseUid} {

      // Owner or admin can read.
      allow read: if isSignedIn()
        && (
          request.auth.uid == firebaseUid
          || isAdmin()
        );


      // New normal user.
      allow create: if isSignedIn()
        && request.auth.uid == firebaseUid
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.role == "user"
        && request.resource.data.coinBalance == 0
        && request.resource.data.totalEarnedCoins == 0
        && request.resource.data.totalRedeemedCoins == 0;


      // Existing reward system requires the user's own client
      // to update wallet fields for AdsGram/Adeasly/daily rewards.
      //
      // Identity and role cannot be changed.
      // Wallet cannot become negative.
      allow update: if isSignedIn()
  && (
    (
      request.auth.uid == firebaseUid
      && resource.data.firebaseUid == request.auth.uid
      && request.resource.data.firebaseUid == resource.data.firebaseUid
      && request.resource.data.role == resource.data.role
      && request.resource.data.telegramId == resource.data.telegramId
      && request.resource.data.coinBalance >= 0
      && request.resource.data.totalEarnedCoins >= resource.data.totalEarnedCoins
      && request.resource.data.totalRedeemedCoins >= resource.data.totalRedeemedCoins
    )
    ||
    isAdmin()
  );


      allow delete: if false;
    }


    // ============================================================
    // SETTINGS
    // ============================================================

    match /settings/{docId} {

      // App needs to read settings.
      allow read: if true;

      // Only admin can modify settings.
      allow write: if isAdmin();
    }


    // ============================================================
    // TASKS
    // ============================================================

    match /tasks/{taskId} {

      // Signed-in users can read tasks.
      // Admin can also read hidden/inactive tasks.
      allow read: if isSignedIn();

      // Only admin can manage tasks.
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // TASK COMPLETIONS
    // Existing AdsGram / Adeasly / SupEarn system
    // ============================================================

    match /taskCompletions/{completionId} {

      // User can read own completion.
      // Admin can read all.
      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.firebaseUid == request.auth.uid
        );


      // Existing client-side reward transaction.
      //
      // Every completion must belong to the authenticated user.
      // Reward must be a positive integer.
      //
      // For SupEarn tasks, the reward must match the task's
      // configured reward and the task must currently be active.
      allow create: if isSignedIn()
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.reward is int
        && request.resource.data.reward > 0
        && request.resource.data.taskId is string
        && request.resource.data.provider is string
        && (
          request.resource.data.provider != "SupEarn"
          ||
          (
            exists(
              /databases/$(database)/documents/tasks/$(request.resource.data.taskId)
            )
            && get(
              /databases/$(database)/documents/tasks/$(request.resource.data.taskId)
            ).data.active == true
            && get(
              /databases/$(database)/documents/tasks/$(request.resource.data.taskId)
            ).data.reward == request.resource.data.reward
          )
        );


      // Completion is permanent.
      allow update, delete: if false;
    }


    // ============================================================
    // REDEEM REQUESTS
    // ============================================================

    match /redeemRequests/{requestId} {

      // Owner or admin can read.
      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.firebaseUid == request.auth.uid
        );


      // User creates their own pending request.
      allow create: if isSignedIn()
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.amount is int
        && request.resource.data.amount > 0;


      // Existing app resolves requests through its transaction/admin flow.
      allow update: if false;


      // Only admin can delete/resolve.
      allow delete: if isAdmin();
    }


    // ============================================================
    // REFERRALS
    // Document ID = Telegram ID
    // ============================================================

    match /referrals/{telegramId} {

      // Signed-in users can read.
      allow read: if isSignedIn();


      // User creates their own referral record.
      allow create: if isSignedIn()
        && request.resource.data.telegramId == telegramId
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.tasksCompleted == 0
        && request.resource.data.bonusPaid == false;


      // User can update their own referral record.
      allow update: if isSignedIn()
        && resource.data.firebaseUid == request.auth.uid
        && request.resource.data.firebaseUid
            == resource.data.firebaseUid
        && request.resource.data.telegramId
            == resource.data.telegramId;


      allow delete: if false;
    }
  }
}
